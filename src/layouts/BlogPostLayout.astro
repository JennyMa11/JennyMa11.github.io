---
import ButtonLink from "@/components/ButtonLink.astro";
import TagPill from "@/components/TagPill.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate, getReadingTime, type BlogPost } from "@/lib/content";

interface Props {
  post: BlogPost;
  newerPost?: BlogPost;
  olderPost?: BlogPost;
}

const { post, newerPost, olderPost } = Astro.props;
const readingTime = getReadingTime(post.body);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage}
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author: {
      "@type": "Person",
      name: "Jenny Ma"
    },
    mainEntityOfPage: new URL(`/blog/${post.slug}/`, Astro.site).href,
    image: new URL(post.data.heroImage ?? "/og.svg", Astro.site).href
  })} />

  <article class="container-prose py-16 sm:py-24">
    <a href="/blog/" class="text-link focus-ring inline-flex min-h-9 items-center rounded-md text-sm">
      ← 返回文章
    </a>

    <header class="mt-10">
      <div class="mb-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-text-subtle">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime}</span>
        {
          post.data.updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>更新于 {formatDate(post.data.updatedDate)}</span>
            </>
          )
        }
      </div>

      <h1 class="text-3xl font-bold leading-tight tracking-tight text-text sm:text-4xl">
        {post.data.title}
      </h1>

      <p class="mt-5 text-lg leading-8 text-text-muted">{post.data.description}</p>

      {
        post.data.tags.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => <TagPill tag={tag} />)}
          </div>
        )
      }
    </header>

    <hr class="my-10 border-border" />

    <div class="content">
      <slot />
    </div>

    <hr class="my-12 border-border" />

    <nav class="flex items-center justify-between text-sm">
      {newerPost ? (
        <a href={`/blog/${newerPost.slug}/`} class="text-link focus-ring rounded-md">
          ← {newerPost.data.title}
        </a>
      ) : <span />}
      {olderPost ? (
        <a href={`/blog/${olderPost.slug}/`} class="text-link focus-ring rounded-md text-right">
          {olderPost.data.title} →
        </a>
      ) : <span />}
    </nav>
  </article>
</BaseLayout>
