---
import TagPill from "@/components/TagPill.astro";
import { formatDate, type Project } from "@/lib/content";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const statusLabels: Record<string, string> = {
  active: "进行中",
  maintained: "维护中",
  archived: "已归档"
};
---

<article id={project.slug} class="surface-card-interactive scroll-mt-24 p-6">
  <div class="flex h-full flex-col gap-4">
    <div>
      <div class="mb-3 flex flex-wrap items-center gap-2 text-sm text-text-subtle">
        <time datetime={project.data.pubDate.toISOString()}>{formatDate(project.data.pubDate)}</time>
        <span class="rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-medium text-accent">
          {statusLabels[project.data.status] ?? project.data.status}
        </span>
      </div>
      <h2 class="text-lg font-semibold tracking-tight text-text">{project.data.title}</h2>
      <p class="mt-3 leading-7 text-text-muted text-[0.94rem]">{project.data.description}</p>
    </div>

    <div class="flex flex-wrap gap-2">
      {project.data.stack.map((tag) => <TagPill tag={tag} href={`/projects/#${project.slug}`} />)}
    </div>

    <div class="mt-auto flex flex-wrap gap-4 pt-2 text-sm">
      {
        project.data.url && (
          <a class="text-link focus-ring rounded-md" href={project.data.url}>
            访问 →
          </a>
        )
      }
      {
        project.data.repository && (
          <a class="text-link focus-ring rounded-md" href={project.data.repository}>
            源码 →
          </a>
        )
      }
    </div>
  </div>
</article>
