---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  class?: string;
}

const { href, variant = "secondary", class: className = "" } = Astro.props;

const variants = {
  primary:
    "bg-[#087b69] text-white border-[#087b69] hover:bg-[#075f53] hover:border-[#075f53] shadow-none hover:shadow-soft",
  secondary:
    "bg-surface text-text border-border hover:bg-accent-soft hover:border-accent",
  ghost:
    "bg-transparent text-text-muted border-transparent hover:text-text hover:bg-surface-muted"
};
---

<a
  href={href}
  class:list={[
    "focus-ring inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border px-5 py-2.5 text-sm font-medium no-underline transition-all duration-200",
    variants[variant],
    className
  ]}
>
  <slot />
</a>
