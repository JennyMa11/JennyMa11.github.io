---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  class?: string;
}

const { href, variant = "secondary", class: className = "" } = Astro.props;

const variants = {
  primary:
    "border-accent bg-gradient-to-r from-accent to-accent-strong text-white hover:from-accent-strong hover:to-accent hover:shadow-md dark:text-white",
  secondary:
    "border-border bg-surface-raised text-text hover:border-border-strong hover:bg-surface-muted hover:shadow-sm",
  ghost:
    "border-transparent bg-transparent text-text-muted hover:text-text hover:bg-surface-muted"
};
---

<a
  href={href}
  class:list={[
    "focus-ring group inline-flex min-h-11 items-center justify-center rounded-xl border px-5 py-2.5 text-sm font-medium no-underline transition-all duration-200",
    variants[variant],
    className
  ]}
>
  <slot />
</a>
