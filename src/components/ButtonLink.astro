---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  class?: string;
}

const { href, variant = "secondary", class: className = "" } = Astro.props;

const variants = {
  primary:
    "bg-accent text-white border-accent hover:bg-accent-strong hover:border-accent-strong shadow-none hover:shadow-soft",
  secondary:
    "bg-surface-muted text-text border-border hover:bg-surface-muted/80 hover:border-border-strong",
  ghost:
    "bg-transparent text-text-muted border-transparent hover:text-text hover:bg-surface-muted"
};
---

<a
  href={href}
  class:list={[
    "focus-ring inline-flex min-h-11 items-center justify-center rounded-xl border px-5 py-2.5 text-sm font-medium no-underline transition-all duration-200",
    variants[variant],
    className
  ]}
>
  <slot />
</a>
