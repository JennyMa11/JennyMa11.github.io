---
import Container from "@/components/Container.astro";
import { site } from "@/lib/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface/60">
  <Container class="flex flex-col gap-5 py-12 text-sm text-text-subtle sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="font-medium text-text">© {year} {site.name}</p>
      <p class="mt-1">使用 Astro 与 GitHub Pages 构建的静态写作系统。</p>
    </div>
    <div class="flex items-center gap-5">
      <a class="text-link focus-ring rounded-md" href="/rss.xml">RSS</a>
      <a class="text-link focus-ring rounded-md" href="https://github.com/JennyMa11">GitHub</a>
    </div>
  </Container>
</footer>
