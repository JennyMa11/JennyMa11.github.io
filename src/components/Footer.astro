---
import Container from "@/components/Container.astro";
import { site } from "@/lib/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface/45">
  <Container class="flex flex-col gap-5 py-10 text-sm text-text-subtle sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="font-medium text-text">© {year} {site.name}</p>
      <p class="mt-1">Static writing system built with Astro and GitHub Pages.</p>
    </div>
    <div class="flex items-center gap-5">
      <a class="text-link focus-ring inline-flex items-center gap-1.5 rounded-sm" href="/rss.xml">
        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16M5 21a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
        </svg>
        RSS
      </a>
      <a class="text-link focus-ring inline-flex items-center gap-1.5 rounded-sm" href="https://github.com/JennyMa11">
        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        GitHub
      </a>
    </div>
  </Container>
</footer>
