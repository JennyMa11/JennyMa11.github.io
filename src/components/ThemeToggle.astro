---

<button
  id="theme-toggle"
  class="focus-ring grid size-11 place-items-center rounded-lg border border-border bg-surface text-text-muted transition-all duration-200 hover:border-border-strong hover:text-text"
  type="button"
  aria-label="切换深色模式"
  title="切换深色模式"
>
  <svg class="hidden size-4 dark:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.36-6.36-1.41 1.41M7.05 16.95l-1.41 1.41m12.72 0-1.41-1.41M7.05 7.05 5.64 5.64"/>
    <circle cx="12" cy="12" r="4"/>
  </svg>
  <svg class="size-4 dark:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
  </svg>
</button>

<script>
  // 初始化主题切换按钮
  function initThemeToggle() {
    const button = document.querySelector<HTMLButtonElement>("#theme-toggle");
    if (!button) return;
    
    // 移除旧的事件监听器（如果有）
    button.replaceWith(button.cloneNode(true));
    const newButton = document.querySelector<HTMLButtonElement>("#theme-toggle");
    
    newButton?.addEventListener("click", () => {
      const nextTheme = document.documentElement.classList.contains("dark") ? "light" : "dark";
      localStorage.setItem("theme", nextTheme);
      document.documentElement.classList.toggle("dark", nextTheme === "dark");
    });
  }
  
  // 首次加载
  initThemeToggle();
  
  // View Transition 后重新初始化
  document.addEventListener("astro:after-swap", initThemeToggle);
  document.addEventListener("astro:page-load", initThemeToggle);
</script>
