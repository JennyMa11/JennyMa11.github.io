---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { site } from "@/lib/site";

const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
};
---

<header class="sticky top-0 z-40 border-b border-border bg-canvas/90 backdrop-blur-xl">
  <div class="container-page flex min-h-16 items-center justify-between gap-4">
    <a href="/" class="focus-ring group inline-flex items-center gap-3 rounded-lg text-sm font-medium text-text no-underline">
      <span class="grid size-8 place-items-center rounded-lg bg-text text-[11px] font-bold text-canvas">JM</span>
      <span class="hidden sm:inline tracking-tight">{site.name}</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="主导航">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "focus-ring rounded-lg px-3.5 py-2 text-sm no-underline transition duration-200",
              isActive(item.href)
                ? "bg-surface-muted font-medium text-text"
                : "text-text-muted hover:text-text"
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="https://github.com/JennyMa11"
        target="_blank"
        rel="noopener noreferrer"
        class="focus-ring grid size-9 place-items-center rounded-lg text-text-muted transition-colors hover:bg-surface-muted hover:text-text"
        aria-label="GitHub 主页"
      >
        <svg class="size-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
      <ThemeToggle />

      <details class="relative lg:hidden">
        <summary class="focus-ring grid size-11 cursor-pointer list-none place-items-center rounded-lg border border-border bg-surface text-text-muted transition hover:border-border-strong hover:text-text" aria-label="打开菜单">
          <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"/>
          </svg>
        </summary>
        <nav class="absolute right-0 mt-2 w-48 rounded-xl border border-border bg-surface p-2 shadow-soft" aria-label="移动端导航">
          {
            site.nav.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "focus-ring block min-h-11 rounded-lg px-3.5 py-3 text-sm no-underline transition-colors",
                  isActive(item.href)
                    ? "bg-surface-muted font-medium text-text"
                    : "text-text-muted hover:text-text"
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
