---
import TagPill from "@/components/TagPill.astro";
import { formatDate, getReadingTime, type BlogPost } from "@/lib/content";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const readingTime = getReadingTime(post.body);
---

<article class="group border-b border-border py-8 last:border-b-0 transition-colors hover:bg-surface-muted/30">
  <div class="flex flex-col gap-3 px-1">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-text-subtle">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime}</span>
      {post.data.featured && (
        <span class="font-medium text-accent">精选</span>
      )}
    </div>
    <h2 class="text-xl font-medium tracking-tight text-text" style="font-family: 'Playfair Display', 'Noto Serif SC', Georgia, serif;">
      <a href={`/blog/${post.slug}/`} class="focus-ring rounded-md no-underline decoration-border-strong group-hover:text-accent group-hover:underline transition-colors">
        {post.data.title}
      </a>
    </h2>
    <p class="max-w-2xl leading-7 text-text-muted text-[0.94rem]">{post.data.description}</p>
    <div class="flex flex-wrap gap-2 pt-1">
      {post.data.tags.map((tag) => <TagPill tag={tag} />)}
    </div>
  </div>
</article>
