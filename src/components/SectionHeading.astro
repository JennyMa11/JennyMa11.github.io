---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  actionHref?: string;
  actionLabel?: string;
}

const { eyebrow, title, description, actionHref, actionLabel } = Astro.props;
---

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div>
    {eyebrow && <p class="section-kicker mb-2">{eyebrow}</p>}
    <h2 class="font-display text-2xl font-bold tracking-tight text-text sm:text-3xl">{title}</h2>
    {description && <p class="mt-3 max-w-2xl leading-7 text-text-muted">{description}</p>}
  </div>
  {
    actionHref && actionLabel && (
      <a href={actionHref} class="text-link focus-ring inline-flex items-center gap-1 rounded-sm text-sm whitespace-nowrap">
        {actionLabel}
        <svg class="size-3.5 transition-transform group-hover:translate-x-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    )
  }
</div>
