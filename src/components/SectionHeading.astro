---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  actionHref?: string;
  actionLabel?: string;
}

const { eyebrow, title, description, actionHref, actionLabel } = Astro.props;
---

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div>
    {eyebrow && <p class="section-kicker mb-2">{eyebrow}</p>}
    <h2 class="text-2xl font-semibold tracking-normal text-text sm:text-3xl">{title}</h2>
    {description && <p class="mt-3 max-w-2xl leading-7 text-text-muted">{description}</p>}
  </div>
  {
    actionHref && actionLabel && (
      <a href={actionHref} class="text-link focus-ring rounded-sm text-sm">
        {actionLabel}
      </a>
    )
  }
</div>
