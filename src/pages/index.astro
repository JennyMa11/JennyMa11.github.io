---
import ButtonLink from "@/components/ButtonLink.astro";
import Container from "@/components/Container.astro";
import PostCard from "@/components/PostCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getFeaturedProjects, getPublishedPosts } from "@/lib/content";
import { site } from "@/lib/site";

const [posts, projects] = await Promise.all([
  getPublishedPosts(),
  getFeaturedProjects(3)
]);

const recentPosts = posts.slice(0, 3);

const layers = [
  { number: "04", title: "系统层", detail: "调度 · 缓存 · 并行", href: "/infra/ch05.html" },
  { number: "03", title: "执行层", detail: "编译 · Graph · Overlap", href: "/infra/ch04.html" },
  { number: "02", title: "算子层", detail: "Attention · Kernel", href: "/infra/ch03.html" },
  { number: "01", title: "模型层", detail: "量化 · 架构优化", href: "/infra/ch02.html" }
];
---

<BaseLayout title={site.title} description={site.description}>
  <Container as="section" class="grid items-center gap-12 pb-20 pt-16 sm:pt-24 lg:grid-cols-[1.12fr_0.88fr] lg:gap-20">
    <div>
      <p class="section-kicker mb-6">JENNY MA / TECHNICAL NOTES</p>
      <h1 class="max-w-2xl text-[clamp(2.5rem,5vw,4rem)] font-extrabold leading-[1.18] tracking-[-0.055em] text-text">
        把复杂技术，<br /><span class="text-accent">整理成清晰的路径。</span>
      </h1>
      <p class="mt-7 max-w-xl text-base leading-8 text-text-muted sm:text-lg">
        记录 AI Infra、机器学习实验与工程实践。从短文到系统手册，持续整理可以复用的知识。
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <ButtonLink href="/infra/" variant="primary">进入 Infra 笔记 <span aria-hidden="true">↗</span></ButtonLink>
        <ButtonLink href="/blog/">浏览文章 <span aria-hidden="true">→</span></ButtonLink>
      </div>
    </div>

    <aside class="rounded-2xl border border-border-strong bg-accent-soft/65 p-5 shadow-soft sm:p-6" aria-label="推理加速知识地图">
      <div class="flex items-center justify-between text-[11px] font-bold tracking-[0.14em] text-accent-strong">
        <span>INFERENCE STACK</span>
        <span class="size-2 rounded-full bg-accent"></span>
      </div>
      <p class="mt-4 text-lg font-bold tracking-tight text-text">沿四层架构，理解推理加速</p>
      <div class="mt-5 grid gap-2">
        {layers.map((layer) => (
          <a href={layer.href} class="focus-ring grid grid-cols-[2rem_1fr_auto] items-center gap-3 rounded-lg border border-border bg-surface px-4 py-3 no-underline transition-all hover:-translate-y-0.5 hover:border-accent hover:shadow-soft">
            <span class="font-mono text-xs font-bold text-accent">{layer.number}</span>
            <span class="font-semibold text-text">{layer.title}</span>
            <span class="hidden text-xs text-text-subtle sm:inline">{layer.detail}</span>
          </a>
        ))}
      </div>
      <a href="/infra/" class="focus-ring mt-5 inline-flex items-center gap-2 rounded-md text-xs font-bold text-accent-strong no-underline hover:underline">
        查看完整学习路线 <span aria-hidden="true">→</span>
      </a>
    </aside>
  </Container>

  <Container as="section" class="border-t border-border py-16 sm:py-20">
    <SectionHeading
      eyebrow="01 / ARTICLES"
      title="最近的文章"
      description="关于模型、实验与写作的持续记录。"
      actionHref="/blog/"
      actionLabel="全部文章"
    />
    <div class="rounded-xl border border-border bg-surface px-4 sm:px-6">
      {recentPosts.map((post) => <PostCard post={post} />)}
    </div>
  </Container>

  <section class="border-t border-border bg-surface/50">
    <Container class="py-16 sm:py-20">
      <SectionHeading
        eyebrow="02 / PROJECTS"
        title="项目实践"
        description="把思路放进实际系统，记录约束、取舍和结果。"
        actionHref="/projects/"
        actionLabel="全部项目"
      />
      <div class="grid gap-4 md:grid-cols-3">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </Container>
  </section>
</BaseLayout>
