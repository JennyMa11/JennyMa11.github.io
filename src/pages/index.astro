---
import ButtonLink from "@/components/ButtonLink.astro";
import Container from "@/components/Container.astro";
import PostCard from "@/components/PostCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getFeaturedPosts, getFeaturedProjects, getPublishedPosts } from "@/lib/content";
import { site } from "@/lib/site";

const [featuredPosts, featuredProjects, posts] = await Promise.all([
  getFeaturedPosts(3),
  getFeaturedProjects(3),
  getPublishedPosts()
]);

const latestPost = posts[0];
---

<BaseLayout title={site.title} description={site.description}>
  <!-- Hero Section with enhanced visual design -->
  <Container as="section" class="relative pb-12 pt-16 sm:pb-16 sm:pt-24">
    <!-- Decorative background elements -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="absolute -right-32 -top-32 h-96 w-96 rounded-full bg-accent/5 blur-3xl"></div>
      <div class="absolute -left-20 bottom-0 h-64 w-64 rounded-full bg-accent/3 blur-2xl"></div>
    </div>

    <div class="relative grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
      <div class="animate-fade-in-up">
        <p class="section-kicker mb-4 text-accent">Jenny Ma / Personal Blog</p>
        <h1 class="max-w-4xl font-display text-4xl font-bold tracking-tight text-text sm:text-6xl lg:text-7xl">
          Writing systems for<br/>
          <span class="text-gradient">technical work</span> that lasts.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-text-muted">
          Notes on machine learning experiments, product systems, research workflows, and the practical craft of building useful tools.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <ButtonLink href="/blog/" variant="primary" class="glow-accent-hover">Read the blog</ButtonLink>
          <ButtonLink href="/projects/">View projects</ButtonLink>
        </div>
      </div>

      <aside class="surface-card gradient-border p-6 animate-slide-in-right stagger-2">
        <p class="section-kicker">Current note</p>
        <p class="mt-4 text-lg font-medium leading-7 text-text">
          Building a sharper public writing practice around reproducible experiments and focused software tools.
        </p>
        <div class="mt-6 grid grid-cols-3 gap-3 border-t border-border pt-5 text-sm">
          <div class="text-center">
            <p class="text-2xl font-bold text-accent">{posts.length}</p>
            <p class="mt-1 text-text-subtle">Posts</p>
          </div>
          <div class="text-center">
            <p class="text-2xl font-bold text-accent">{featuredProjects.length}</p>
            <p class="mt-1 text-text-subtle">Projects</p>
          </div>
          <div class="text-center">
            <p class="text-2xl font-bold text-accent">Static</p>
            <p class="mt-1 text-text-subtle">Deploy</p>
          </div>
        </div>
      </aside>
    </div>
  </Container>

  <!-- Featured Writing Section -->
  <Container as="section" class="grid gap-10 pb-16 lg:grid-cols-[1.25fr_0.75fr]">
    <div class="animate-fade-in-up stagger-3">
      <SectionHeading
        eyebrow="Featured writing"
        title="Selected essays and working notes."
        description="A compact reading list for the ideas that define this site."
        actionHref="/blog/"
        actionLabel="All posts"
      />
      <div class="rounded-xl border-y border-border bg-surface/35 px-1">
        {featuredPosts.map((post) => <PostCard post={post} />)}
      </div>
    </div>

    <aside class="space-y-4 animate-fade-in-up stagger-4">
      <div class="surface-card p-6">
        <p class="section-kicker">About</p>
        <p class="mt-4 leading-7 text-text-muted">
          I use this site as a durable home for research notes, engineering decisions, and project writeups.
        </p>
        <a href="/about/" class="text-link focus-ring mt-5 inline-flex items-center gap-1.5 rounded-sm text-sm">
          More about me
          <svg class="size-3.5 transition-transform group-hover:translate-x-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      {
        latestPost && (
          <div class="surface-card-interactive gradient-border p-6">
            <p class="section-kicker">Latest</p>
            <a href={`/blog/${latestPost.slug}/`} class="focus-ring mt-4 block rounded-sm text-lg font-semibold text-text no-underline hover:text-accent transition-colors">
              {latestPost.data.title}
            </a>
            <p class="mt-3 text-sm leading-6 text-text-muted">{latestPost.data.description}</p>
          </div>
        )
      }
    </aside>
  </Container>

  <!-- Featured Projects Section with enhanced styling -->
  <section class="relative border-y border-border bg-surface/42 overflow-hidden">
    <div class="pointer-events-none absolute inset-0 dot-pattern opacity-30" aria-hidden="true"></div>
    <Container class="relative py-14">
      <SectionHeading
        eyebrow="Featured projects"
        title="Selected project work."
        description="Small, practical systems with clear constraints and durable notes."
        actionHref="/projects/"
        actionLabel="All projects"
      />
      <div class="grid gap-4 md:grid-cols-3">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </Container>
  </section>

  <!-- Newsletter/Subscribe hint section -->
  <Container as="section" class="py-16 text-center">
    <div class="animate-fade-in-up stagger-5">
      <p class="section-kicker mb-3">Stay updated</p>
      <h2 class="text-2xl font-semibold tracking-normal text-text sm:text-3xl">
        Follow along with the <span class="text-gradient">RSS feed</span>.
      </h2>
      <p class="mt-3 text-text-muted">
        No algorithms, no noise — just the writing.
      </p>
      <div class="mt-6">
        <ButtonLink href="/rss.xml" variant="secondary" class="group">
          <svg class="mr-2 size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16M5 21a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
          </svg>
          Subscribe via RSS
        </ButtonLink>
      </div>
    </div>
  </Container>
</BaseLayout>
