---
import ButtonLink from "@/components/ButtonLink.astro";
import Container from "@/components/Container.astro";
import PostCard from "@/components/PostCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getFeaturedPosts, getFeaturedProjects, getPublishedPosts } from "@/lib/content";
import { site } from "@/lib/site";

const [featuredPosts, featuredProjects, posts] = await Promise.all([
  getFeaturedPosts(3),
  getFeaturedProjects(3),
  getPublishedPosts()
]);

const latestPost = posts[0];
---

<BaseLayout title={site.title} description={site.description}>
  <Container as="section" class="pb-12 pt-16 sm:pb-16 sm:pt-24">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
      <div>
        <p class="section-kicker mb-4 text-accent">Jenny Ma / Personal Blog</p>
        <h1 class="max-w-4xl text-4xl font-semibold tracking-normal text-text sm:text-6xl">
          Writing systems for technical work that lasts.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-text-muted">
          Notes on machine learning experiments, product systems, research workflows, and the practical craft of building useful tools.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <ButtonLink href="/blog/" variant="primary">Read the blog</ButtonLink>
          <ButtonLink href="/projects/">View projects</ButtonLink>
        </div>
      </div>

      <aside class="surface-card p-5">
        <p class="section-kicker">Current note</p>
        <p class="mt-4 text-lg font-medium leading-7 text-text">
          Building a sharper public writing practice around reproducible experiments and focused software tools.
        </p>
        <div class="mt-6 grid grid-cols-3 gap-3 border-t border-border pt-5 text-sm">
          <div>
            <p class="font-semibold text-text">{posts.length}</p>
            <p class="text-text-subtle">Posts</p>
          </div>
          <div>
            <p class="font-semibold text-text">{featuredProjects.length}</p>
            <p class="text-text-subtle">Projects</p>
          </div>
          <div>
            <p class="font-semibold text-text">Static</p>
            <p class="text-text-subtle">Deploy</p>
          </div>
        </div>
      </aside>
    </div>
  </Container>

  <Container as="section" class="grid gap-10 pb-16 lg:grid-cols-[1.25fr_0.75fr]">
    <div>
      <SectionHeading
        eyebrow="Featured writing"
        title="Selected essays and working notes."
        description="A compact reading list for the ideas that define this site."
        actionHref="/blog/"
        actionLabel="All posts"
      />
      <div class="rounded-lg border-y border-border bg-surface/35 px-1">
        {featuredPosts.map((post) => <PostCard post={post} />)}
      </div>
    </div>

    <aside class="space-y-4">
      <div class="surface-card p-5">
        <p class="section-kicker">About</p>
        <p class="mt-4 leading-7 text-text-muted">
          I use this site as a durable home for research notes, engineering decisions, and project writeups.
        </p>
        <a href="/about/" class="text-link focus-ring mt-5 inline-block rounded-sm text-sm">More about me</a>
      </div>

      {
        latestPost && (
          <div class="surface-card-interactive p-5">
            <p class="section-kicker">Latest</p>
            <a href={`/blog/${latestPost.slug}/`} class="focus-ring mt-4 block rounded-sm text-lg font-semibold text-text no-underline hover:text-accent">
              {latestPost.data.title}
            </a>
            <p class="mt-3 text-sm leading-6 text-text-muted">{latestPost.data.description}</p>
          </div>
        )
      }
    </aside>
  </Container>

  <section class="border-y border-border bg-surface/42">
    <Container class="py-14">
      <SectionHeading
        eyebrow="Featured projects"
        title="Selected project work."
        description="Small, practical systems with clear constraints and durable notes."
        actionHref="/projects/"
        actionLabel="All projects"
      />
      <div class="grid gap-4 md:grid-cols-3">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </Container>
  </section>
</BaseLayout>
