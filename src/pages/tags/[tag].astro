---
import Container from "@/components/Container.astro";
import PageHeader from "@/components/PageHeader.astro";
import PostCard from "@/components/PostCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedPosts, slugifyTag } from "@/lib/content";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = new Set<string>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      tags.add(slugifyTag(tag));
    }
  }

  return [...tags].map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const posts = await getPublishedPosts();
const filtered = posts.filter((post) =>
  post.data.tags.some((t) => slugifyTag(t) === tag)
);
---

<BaseLayout title={`标签：${tag}`} description={`标记为 ${tag} 的文章。`}>
  <PageHeader
    eyebrow="标签"
    title={tag}
    description={`标记为此主题的 ${filtered.length} 篇文章。`}
  />

  <Container as="section" class="pb-20">
    <div class="rounded-xl border-y border-border bg-surface/40 px-2">
      {filtered.map((post) => <PostCard post={post} />)}
    </div>
  </Container>
</BaseLayout>
