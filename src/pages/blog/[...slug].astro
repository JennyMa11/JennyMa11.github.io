---
import BlogPostLayout from "@/layouts/BlogPostLayout.astro";
import { getPublishedPosts } from "@/lib/content";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      newerPost: index > 0 ? posts[index - 1] : undefined,
      olderPost: index < posts.length - 1 ? posts[index + 1] : undefined
    }
  }));
}

const { post, newerPost, olderPost } = Astro.props;
const { Content } = await post.render();
---

<BlogPostLayout post={post} newerPost={newerPost} olderPost={olderPost}>
  <Content />
</BlogPostLayout>
