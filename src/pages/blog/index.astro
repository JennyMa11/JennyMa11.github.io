---
import Container from "@/components/Container.astro";
import PageHeader from "@/components/PageHeader.astro";
import PostCard from "@/components/PostCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedPosts } from "@/lib/content";

const posts = await getPublishedPosts();
---

<BaseLayout title="Blog" description="Essays, notes, and technical writing.">
  <PageHeader
    eyebrow="Blog"
    title="Essays and working notes."
    description="Long-form posts, concise notes, and technical writeups arranged by publication date."
  />

  <Container as="section" class="pb-16">
    <div class="rounded-lg border-y border-border bg-surface/35 px-1">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </Container>
</BaseLayout>
