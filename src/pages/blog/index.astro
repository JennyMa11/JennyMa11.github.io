---
import Container from "@/components/Container.astro";
import PageHeader from "@/components/PageHeader.astro";
import PostCard from "@/components/PostCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedPosts } from "@/lib/content";

const posts = await getPublishedPosts();
---

<BaseLayout title="文章" description="随笔、笔记和技术写作。">
  <PageHeader
    eyebrow="文章"
    title="随笔与工作笔记。"
    description="长文、简短笔记和技术总结，按发布日期排列。"
  />

  <Container as="section" class="pb-20">
    <nav class="mb-6 flex flex-wrap gap-3 text-sm" aria-label="文章浏览方式">
      <a href="/archive/" class="focus-ring rounded-lg border border-border bg-surface px-4 py-2 text-text-muted no-underline hover:border-accent hover:text-accent">按时间归档 →</a>
      <a href="/tags/" class="focus-ring rounded-lg border border-border bg-surface px-4 py-2 text-text-muted no-underline hover:border-accent hover:text-accent">按主题浏览 →</a>
    </nav>
    <div class="rounded-xl border-y border-border bg-surface/40 px-2">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </Container>
</BaseLayout>
