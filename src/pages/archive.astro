---
import Container from "@/components/Container.astro";
import PageHeader from "@/components/PageHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate, getPublishedPosts, groupPostsByYear } from "@/lib/content";

const posts = await getPublishedPosts();
const groups = groupPostsByYear(posts);
const years = Object.keys(groups).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title="归档" description="所有已发布文章的时间线归档。">
  <PageHeader
    eyebrow="归档"
    title="所有已发布的文章。"
    description="按时间线浏览，快速查找过往内容。"
  />

  <Container as="section" class="pb-20">
    <div class="space-y-12">
      {
        years.map((year) => (
          <section>
            <h2 class="mb-5 text-2xl font-bold tracking-tight text-text">{year}</h2>
            <div class="divide-y divide-border rounded-xl border-y border-border bg-surface/40 px-2">
              {groups[year].map((post) => (
                <a href={`/blog/${post.slug}/`} class="focus-ring grid gap-2 rounded-lg px-4 py-5 no-underline transition hover:bg-surface-muted/30 sm:grid-cols-[120px_1fr]">
                  <time class="text-sm text-text-subtle" datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                  <span class="font-medium text-text hover:text-accent transition-colors">
                    {post.data.title}
                  </span>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </Container>
</BaseLayout>
